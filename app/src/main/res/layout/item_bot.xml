<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardElevation="0dp"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Серверный индикатор (воспринимается глазом как часть рамки) -->
        <View
            android:id="@+id/view_status_indicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/text_medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Заголовок: Название и статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bot_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мой бот"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_copy_token"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_bot_token_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="vk1.a.••••••"
                        android:textColor="@color/text_medium"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        app:drawableEndCompat="@drawable/ic_copy"
                        app:drawableTint="@color/text_medium"
                        android:drawablePadding="6dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_bot_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Остановлен"
                android:textColor="@color/text_medium"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Статистика -->
        <LinearLayout
            android:id="@+id/ll_statistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_bot_processed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Обработано: 0"
                android:textColor="@color/text_medium"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"
                app:drawableStartCompat="@drawable/ic_email"
                app:drawableTint="@color/text_medium"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/tv_bot_answered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Отвечено: 0"
                android:textColor="@color/text_medium"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"
                app:drawableStartCompat="@drawable/ic_chat"
                app:drawableTint="@color/text_medium"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/tv_bot_uptime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Время: 00:00:00"
                android:textColor="@color/text_medium"
                android:fontFamily="monospace"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_timer"
                app:drawableTint="@color/text_medium"
                android:drawablePadding="8dp" />
        </LinearLayout>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.3" />

        <!-- Кнопки управления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_bot"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="24dp"
                android:text="Запустить"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textAllCaps="false"
                app:backgroundTint="@color/white"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/white"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_bot"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Изменить"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_bot"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Удалить"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
